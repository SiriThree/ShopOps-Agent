      { "configKey": "agent_tool_approval_enabled", "configValue": "true", "valueType": "boolean" },
      { "configKey": "agent_model_policy", "configValue": "conservative", "valueType": "string" }
    ],
    "taskCreateParam": {
      "taskType": "daily_review",
      "userInput": "帮我生成今天店铺运营复盘",
      "dateRange": {
        "start": "2026-07-18",
        "end": "2026-07-18"
      }
    },
    "expectations": {
      "finalStatusIn": ["SUCCESS"],
      "expectedToolCodes": [
        "order.query_summary",
