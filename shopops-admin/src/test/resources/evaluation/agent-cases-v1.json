  },
  {
    "caseId": "tool-approval-on-001",
    "scenario": "manual_tool_invoke",
    "description": "高风险退款工具在审批开启时应返回 APPROVAL_REQUIRED 并创建审批单",
    "headers": {
      "X-Tenant-Id": "1",
      "X-Shop-Id": "1",
      "X-User-Id": "1",
      "X-User-Name": "admin",
      "X-User-Roles": "ADMIN"
    },
    "shopConfigs": [
      { "configKey": "refund_rate_warn_threshold", "configValue": "0.08", "valueType": "number" },
      { "configKey": "negative_comment_warn_threshold", "configValue": "10", "valueType": "number" },
      { "configKey": "agent_tool_approval_enabled", "configValue": "true", "valueType": "boolean" },
      { "configKey": "agent_model_policy", "configValue": "balanced", "valueType": "string" }
    ],
    "manualToolCode": "order.refund_execute",
    "manualToolInput": {
      "shopId": 1,
      "refundAmount": 1288,
      "reason": "evaluation approval on"
    },
    "expectations": {
      "finalStatusIn": ["APPROVAL_REQUIRED"],
      "expectApprovalCreated": true,
      "expectDegraded": false
    }
  },
  {
    "caseId": "tool-approval-off-002",
    "scenario": "manual_tool_invoke",
    "description": "高风险退款工具在审批关闭时应直接执行，并写入绕过审批的日志标记",
    "headers": {
      "X-Tenant-Id": "1",
      "X-Shop-Id": "1",
      "X-User-Id": "1",
      "X-User-Name": "admin",
      "X-User-Roles": "ADMIN"
    },
    "shopConfigs": [
      { "configKey": "refund_rate_warn_threshold", "configValue": "0.08", "valueType": "number" },
      { "configKey": "negative_comment_warn_threshold", "configValue": "10", "valueType": "number" },
      { "configKey": "agent_tool_approval_enabled", "configValue": "false", "valueType": "boolean" },
      { "configKey": "agent_model_policy", "configValue": "balanced", "valueType": "string" }
    ],
    "manualToolCode": "order.refund_execute",
    "manualToolInput": {
      "shopId": 1,
      "refundAmount": 1288,
      "reason": "evaluation approval off"
    },
    "expectations": {
      "finalStatusIn": ["SUCCESS"],
      "expectApprovalCreated": false,
      "expectDegraded": false,
      "expectedLogErrorCode": "APPROVAL_BYPASSED_BY_SHOP_CONFIG"
    }
  },
